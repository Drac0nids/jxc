{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win:portable": "tauri build --target x86_64-pc-windows-gnu --bundles app",
    "tauri:build:win:portable:dist": "npm run tauri:build:win:portable && bash scripts/package_windows_portable.sh",
    "tauri:build:win:nsis": "tauri build --target x86_64-pc-windows-msvc --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "axios": "^1.13.6",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^5.4.14",
    "vue-tsc": "^3.1.5"
  }
}
