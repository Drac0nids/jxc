APP_HOST=0.0.0.0
APP_PORT=8080

# 请在生产环境中替换为强随机密钥
JWT_SECRET=change_me_in_prod

# 单位：秒
JWT_ACCESS_EXPIRES=7200
JWT_REFRESH_EXPIRES=604800

# 是否允许负库存：true/false
ALLOW_NEGATIVE_STOCK=false

# 存储后端：memory / postgres
STORAGE_BACKEND=postgres

# STORAGE_BACKEND=postgres 时必填
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jxc

# 可选：Redis（用于幂等/缓存，未配置则退回内存态）
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL 连接池大小
PG_MAX_CONNECTIONS=10

# 第三方条码查询（新建商品建议名称）
# 未配置 BARCODE_LOOKUP_API_URL 时，接口将仅使用本地缓存并在回源阶段降级
BARCODE_LOOKUP_API_URL=
BARCODE_LOOKUP_API_KEY=

# 条码回源超时（毫秒）
BARCODE_LOOKUP_TIMEOUT_MS=3000

# 缓存 TTL（秒）
# FOUND：建议较长缓存；NOT_FOUND：负缓存，建议较短
BARCODE_LOOKUP_FOUND_TTL_SECS=2592000
BARCODE_LOOKUP_NOT_FOUND_TTL_SECS=86400
